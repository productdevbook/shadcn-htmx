{
  "name": "shadcn-htmx",
  "version": "0.0.0",
  "description": "shadcn-style UI components for htmx v4 + Tailwind v4 — 82 web-standards components in five flavours, with a flavour-aware CLI.",
  "license": "MIT",
  "author": "productdevbook",
  "type": "module",
  "keywords": [
    "shadcn",
    "htmx",
    "tailwindcss",
    "components",
    "ui",
    "ui-components",
    "component-library",
    "accessibility",
    "wai-aria",
    "jinja2",
    "go-templates",
    "phoenix",
    "hono",
    "cli",
    "registry",
    "web-standards"
  ],
  "homepage": "https://github.com/productdevbook/shadcn-htmx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productdevbook/shadcn-htmx.git"
  },
  "bugs": {
    "url": "https://github.com/productdevbook/shadcn-htmx/issues"
  },
  "funding": "https://github.com/sponsors/productdevbook",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "shadcn-htmx": "scripts/cli.mjs"
  },
  "files": [
    "scripts/cli.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "node scripts/cli.mjs",
    "test:cli": "bun test scripts/cli.test.ts",
    "dev": "concurrently -k -n server,css -c blue,green \"bun run dev:server\" \"bun run dev:css\"",
    "dev:server": "bun run --hot app/server.tsx",
    "dev:css": "tailwindcss -i app/styles/input.css -o public/styles.css --watch",
    "build:css": "tailwindcss -i app/styles/input.css -o public/styles.css --minify",
    "build:registry": "bun run scripts/build-registry.ts",
    "build": "bun run build:registry && bun run build:css",
    "build:static": "bun run build:registry && bun run build:css && bun run scripts/build-static.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:geom": "playwright test tests/geometry.spec.ts",
    "test:kbd": "playwright test tests/keyboard.spec.ts",
    "release": "bun run typecheck && bun run test:cli && bumpp --commit --tag --push"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "latest",
    "bumpp": "^11.0.0",
    "concurrently": "^10.0.3",
    "hono": "^4.12.23",
    "shiki": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
